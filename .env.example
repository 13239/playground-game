# 기존 인증 서버와 같은 공개 Origin을 지정한다. 실제 비밀값은 버전 관리하지 않는다.
# 다른 PC에서는 이 파일을 같은 폴더의 .env로 복사하고 GAME_SERVICE_SECRET을 채운다.
# npm run dev가 .env를 자동으로 읽는다. 변경 후 game 서버를 재시작한다.
# 로컬 포트는 back(8080)·chat(8081) 다음인 8082다. dev/prod는 배포 포트를 명시한다.
PORT=8082
# HTTP 개발 인증을 사용할 때만 dev. HTTPS 운영에서는 prod로 설정한다.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
GAME_BACKEND_ORIGIN=http://localhost:8080
# 별도의 32바이트 Base64 키를 한 번 생성해 아래와 back의 game.shooting.service-secret에 똑같이 넣는다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# JWT 키·front AUTH_COOKIE_SECRET과 다른 값을 사용한다. 두 서버용 키를 각각 생성하면 서로 통신할 수 없다.
GAME_SERVICE_SECRET=CHANGE_ME_GAME_SERVICE_SECRET_BASE64_32_BYTES
# 운영 Spring이 mTLS를 요구하면 게임 서버에도 전용 인증서 경로를 공급한다.
GAME_BACKEND_CA=
GAME_BACKEND_CERT=
GAME_BACKEND_KEY=
GAME_MAX_ROOMS=128
